# Optional server-side AI authoring. Copy to .env.local and restart the server.
# Keep both values out of NEXT_PUBLIC_* variables and client code.
OPENAI_API_KEY=
# Set an account-accessible model that supports Responses structured output.
OPENAI_CURRICULUM_MODEL=
# Server-only. Book Studio proxies workforce login and curriculum writes.
SUPERADMIN_API_URL=https://superadminapi.nexsyrus.com/api/v1/
SCHOOLIMS_API_URL=https://simsapi.nexsyrus.com/api/v1/
